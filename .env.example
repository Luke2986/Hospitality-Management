# Copy to .env and fill in. Never commit .env.
# Copia in .env e compila. Non fare mai commit di .env.

# PostgreSQL connection string / Stringa di connessione PostgreSQL (required / obbligatoria)
# Remote databases: add ?sslmode=require (certificate verified). Private CA: ?sslmode=verify-full&sslrootcert=/path/ca.crt
# Database remoti: aggiungi ?sslmode=require (certificato verificato). CA propria: ?sslmode=verify-full&sslrootcert=/percorso/ca.crt
DATABASE_URL=postgres://user:password@localhost:5432/hospitality

# Signs the session cookie / Firma il cookie di sessione (required in production / obbligatoria in produzione)
# Generate / Genera: openssl rand -hex 32
SESSION_SECRET=

# Resend API key for verification and password-reset emails (required in production).
# Chiave API Resend per le email di conferma e recupero password (obbligatoria in produzione).
# Empty in development: emails are printed to the server log. / Vuota in sviluppo: le email finiscono nel log.
RESEND_API_KEY=

# Sender, on a domain verified on Resend (required in production)
# Mittente, su un dominio verificato su Resend (obbligatorio in produzione)
EMAIL_FROM="Hospitality Manager <noreply@example.com>"

# Public URL of the app, used for links in emails (required in production)
# URL pubblico dell'app, usato per i link nelle email (obbligatorio in produzione)
APP_URL=http://localhost:5000

# Cloudflare Turnstile bot protection on widget bookings (optional, set both or neither)
# Protezione anti-bot Cloudflare Turnstile sulle prenotazioni del widget (facoltativa, entrambe o nessuna)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server port / Porta del server (default 5000)
PORT=5000

# Disposable database for npm test: every test wipes all its data. Never point it at real data.
# Database usa e getta per npm test: ogni test ne cancella tutti i dati. Mai usare un database con dati veri.
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/hospitality_test
